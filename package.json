{
  "name": "@pas7/nestjs-strict-json",
  "version": "1.0.0",
  "description": "Strict JSON parsing for NestJS (Express/Fastify) with duplicate-key detection",
  "license": "Apache-2.0",
  "author": {
    "name": "PAS7",
    "email": "pas7std@gmail.com",
    "url": "https://pas7.com.ua/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pas7-studio/nestjs-strict-json.git"
  },
  "homepage": "https://pas7.com.ua/blog/en/nestjs-strict-json",
  "bugs": {
    "url": "https://github.com/pas7-studio/nestjs-strict-json/issues",
    "email": "pas7std@gmail.com"
  },
  "keywords": [
    "nestjs",
    "strict-json",
    "duplicate-keys",
    "fastify",
    "express",
    "security"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "bench:parser": "npm run build && node scripts/benchmark-parser.mjs",
    "bench:compare": "npm run build && node scripts/benchmark-comparison.mjs",
    "benchmark": "node performance/run-all-benchmarks.mjs",
    "benchmark:parser": "npx vitest run performance/benchmarks/parser/",
    "benchmark:adapters": "npx vitest run performance/benchmarks/adapters/",
    "benchmark:comparisons": "npx vitest run performance/benchmarks/comparisons/",
    "benchmark:report": "node performance/utils/generate-report.mjs",
    "lint": "npx eslint .",
    "test": "npx vitest run",
    "test:e2e": "npx vitest run --config vitest.e2e.config.ts",
    "test:watch": "npx vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/testing": "11.1.19",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^10.3.0",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "reflect-metadata": "0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "8.0.10",
    "vitest": "^4.1.5"
  }
}
