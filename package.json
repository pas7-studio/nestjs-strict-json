{
  "name": "@pas7/nestjs-strict-json",
  "version": "0.5.1",
  "description": "Strict JSON parsing for NestJS (Express/Fastify) with duplicate-key detection",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pas7-studio/nestjs-strict-json.git"
  },
  "homepage": "https://github.com/pas7-studio/nestjs-strict-json",
  "bugs": {
    "url": "https://github.com/pas7-studio/nestjs-strict-json/issues"
  },
  "keywords": [
    "nestjs",
    "strict-json",
    "duplicate-keys",
    "fastify",
    "express",
    "security"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "bench:parser": "bun run build && bun scripts/benchmark-parser.mjs",
    "bench:compare": "bun run build && bun scripts/benchmark-comparison.mjs",
    "benchmark": "bun performance/run-all-benchmarks.mjs",
    "benchmark:parser": "bunx vitest run performance/benchmarks/parser/",
    "benchmark:adapters": "bunx vitest run performance/benchmarks/adapters/",
    "benchmark:comparisons": "bunx vitest run performance/benchmarks/comparisons/",
    "benchmark:report": "bun performance/utils/generate-report.mjs",
    "lint": "bunx eslint .",
    "test": "bunx vitest run",
    "test:e2e": "bunx vitest run --config vitest.e2e.config.ts",
    "test:watch": "bunx vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "bun-types": "latest",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/testing": "10.4.22",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^8.57.0",
    "express": "^4.19.2",
    "fastify": "^4.26.0",
    "reflect-metadata": "0.2.2",
    "tsup": "^8.0.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
